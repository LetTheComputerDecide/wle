{
	"name": "wle",
	"version": "0.1.0",
	"description": "Concurrent producer/consumer that fetches pages and extracts their hyperlinks",
	"type": "module",
	"private": true,
	"bin": {
		"wle": "dist/cli.js"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.1.0",
	"scripts": {
		"start": "node src/cli.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"schema": "node src/cli.ts --print-config-schema > config.schema.json"
	},
	"dependencies": {
		"htmlparser2": "^12.0.0",
		"p-limit": "^7.3.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"fast-check": "^4.10.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
